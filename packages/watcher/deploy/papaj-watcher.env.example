# Copy to a private env file that is not committed.
# Point this at your dashboard. The built-in placeholder is loopback only.
RAMION_DASHBOARD_URL=http://127.0.0.1:8780
PAPAJ_INTERVAL=1.0
PAPAJ_CAMERAS=overhead,wrist,observer
PAPAJ_TIMEOUT=8.0
PAPAJ_LOG=/var/log/papaj-watcher/events.jsonl
PAPAJ_EVIDENCE=/var/lib/papaj-watcher/evidence
PAPAJ_WEBHOOK_URL=
PAPAJ_CONFIG=/etc/papaj-watcher/thresholds.json

# STOP is off unless you explicitly enable it. Non-loopback URLs also need
# PAPAJ_CONFIRM_REMOTE_STOP=1 together with PAPAJ_ENABLE_STOP=1.
PAPAJ_ENABLE_STOP=0
PAPAJ_CONFIRM_REMOTE_STOP=0

# Optional vision layer (OpenAI-compatible or local). Leave disabled until
# you choose a provider and put a key in a private env file.
PAPAJ_VLM_ENABLED=0
PAPAJ_VLM_BASE_URL=
PAPAJ_VLM_API_KEY=
PAPAJ_VLM_MODEL=gpt-4o-mini
PAPAJ_VLM_TIMEOUT=20
PAPAJ_VLM_CAN_STOP=0

# Intent detector (session risk score). Enabled by default.
PAPAJ_INTENT=1
PAPAJ_INTENT_WINDOW=60
PAPAJ_INTENT_COOLDOWN=30
